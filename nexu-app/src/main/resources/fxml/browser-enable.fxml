<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="365.0" prefWidth="650.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="lu.nowina.nexu.view.ui.BrowserEnableController">

    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
            </padding>
            <children>
                <Label fx:id="heading" styleClass="aboutTitle" wrapText="true" />
                <Label fx:id="description" maxWidth="610.0" wrapText="true" />
                <Label fx:id="instructions" maxWidth="610.0" wrapText="true" />
                <Label fx:id="endpointLabel" />
                <Hyperlink fx:id="endpoint" maxWidth="610.0" wrapText="true" />
                <Label fx:id="security" maxWidth="610.0" wrapText="true" />
                <Label fx:id="status" maxWidth="610.0" wrapText="true" />
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="btn-container">
            <children>
                <Button fx:id="openBrowser" mnemonicParsing="false" styleClass="btn-primary" />
                <Button fx:id="close" mnemonicParsing="false" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
